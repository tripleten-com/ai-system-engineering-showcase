{
  "name": "TripleTen Cloud Platform — Autonomous Incident Defense Showcase",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    // docker-in-docker, NOT docker-outside-of-docker. With the outside-of-docker
    // feature the daemon is the Codespaces host VM's, whose filesystem does not
    // contain /workspaces — so every bind mount in infra/docker-compose.yml
    // silently resolved to an empty directory the daemon created on the host.
    // Postgres failed loudest ("could not read from input file: Is a directory"
    // on 01-init-vector.sql), but the Prometheus config, Grafana provisioning,
    // and LocalStack init script were all equally missing. An in-container
    // daemon shares this filesystem, so the mounts resolve to the real files.
    //
    // This does not cost us the image cache. The feature keeps /var/lib/docker
    // and /var/lib/containerd in named volumes suffixed with ${devcontainerId},
    // so pulled images and build layers survive a container rebuild. Only a
    // brand-new Codespace starts cold.
    // Pinned to major 4, not 2. `:2` resolves to 2.17, which predates the
    // /var/lib/containerd volume the feature now declares — and without it a
    // dind daemon on an overlayfs root filesystem (which is what Codespaces
    // gives us) hits overlay-on-overlay snapshotter failures.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      // `docker-compose` (hyphen) is what `poe up` / `make up` invoke, and the
      // v1 Python binary cannot parse the `include:` in the root compose.yaml.
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [
    3000,
    3001,
    8000,
    16686,
    9090,
    4566,
    5432,
    6379
  ],
  "portsAttributes": {
    "3000": {
      "label": "Incident War Room (Frontend)",
      "onAutoForward": "openBrowser"
    },
    "3001": {
      "label": "Grafana Dashboards",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Incident Agent API",
      "onAutoForward": "silent"
    },
    "16686": {
      "label": "Jaeger UI",
      "onAutoForward": "notify"
    },
    "9090": {
      "label": "Prometheus",
      "onAutoForward": "silent"
    },
    "4566": {
      "label": "LocalStack",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "PostgreSQL Vector",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests",
          "packages/contracts/tests",
          "services/incident-agent-api/tests",
          "services/remediation-worker/tests"
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "ms-azuretools.vscode-docker",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bierner.markdown-mermaid"
      ]
    }
  }
}
