    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput During Stampede",
      "description": "rate(http_requests_total[15s]). Scenario 2 replaces the baseline throughput expression outright with 120 + 60·sin(2.1t) clamped to [60, 180] — a roughly three-second oscillation, not a clean drop. Retry storms do not fail politely.",
      "datasource": { "type": "prometheus", "uid": "tripleten-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#9CA3AF" },
