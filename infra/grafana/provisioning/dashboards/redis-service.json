{
  "uid": "tt-svc-redis",
  "title": "TripleTen Cloud — Redis (cache tier)",
  "description": "Service view for the Redis cache tier: memory saturation, cache hit ratio, and the throughput oscillation a thundering herd produces. Scenario 2 (cache_thundering_herd) is the run this dashboard is built to read.",
  "tags": ["tripleten", "service", "redis", "project-1"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "refresh": "1s",
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": { "refresh_intervals": ["1s", "5s", "10s", "30s", "1m"] },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "links": [
    { "title": "TripleTen Cloud", "type": "dashboards", "tags": ["tripleten"], "asDropdown": true, "icon": "external link", "includeVars": false, "keepTime": true, "tooltip": "Other TripleTen Cloud dashboards", "url": "" }
  ],
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Memory Utilization",
      "description": "redis_memory_utilization_pct. Baseline band is 39-41%. Scenario 2 ramps it to 97.8% and Redis starts refusing writes with OOM.",
      "datasource": { "type": "prometheus", "uid": "tripleten-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10B981", "value": null },
              { "color": "#F59E0B", "value": 70 },
              { "color": "#EF4444", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "tripleten-prometheus" },
          "expr": "redis_memory_utilization_pct",
          "legendFormat": "memory"
        }
      ]
    },
    {
