      "datasource": { "type": "prometheus", "uid": "tripleten-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#EF4444", "value": null },
              { "color": "#F59E0B", "value": 90 },
              { "color": "#10B981", "value": 98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
