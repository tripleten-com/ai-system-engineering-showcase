# ==============================================================================
# TripleTen Cloud Platform — Autonomous Incident Defense Showcase
# Environment Configuration
# ==============================================================================

# REQUIRED. Shared by incident-agent-api and remediation-worker to sign and verify the
# worker completion callback. Both services refuse to start without it — there is no
# source-code fallback, because one that silently works would let the /callback auth
# gate pass on a stack nobody configured. This file is the only place the demo value
# is written down.
CALLBACK_SECRET=tt-incident-callback-secret-key-99382

# Optional LLM API Key (leave blank for deterministic offline emulator mode)
OPENAI_API_KEY=

# Database & Cache URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres-vector:5432/tripleten_db
REDIS_URL=redis://redis:6379/0

# LocalStack AWS Emulation Configuration
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localstack:4566

# SQS Queue & S3 Bucket Names
SQS_CUSTOMER_JOBS_QUEUE=customer-jobs
SQS_CUSTOMER_DLQ_QUEUE=customer-dlq
SQS_REMEDIATION_JOBS_QUEUE=remediation-jobs
SQS_REMEDIATION_DLQ_QUEUE=remediation-dlq
S3_POSTMORTEMS_BUCKET=tripleten-cloud-postmortems

# OpenTelemetry & Observability
OTEL_SERVICE_NAME=incident-agent-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# API & Worker Configuration
AGENT_API_URL=http://incident-agent-api:8000
API_PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# ==============================================================================
# War Room build-time settings
# ==============================================================================
# Vite bakes `import.meta.env.VITE_*` into the bundle, so these are **build args**, not runtime
# environment: they must be set before `docker compose build`, and changing one requires a rebuild.
# Compose forwards them from this file (see the `args:` block on incident-war-room).
#
# All four are optional. Left blank, the frontend uses its own defaults: same-origin for the API,
# `/s3` for the archived postmortem, and the AI Systems Engineering programme page for the CTA.

# The footer CTA's destination. Defaults to https://tripleten.com/systems-engineer/ — the programme
# this demo is a showcase for. Override it for a campaign-specific landing page.
VITE_CURRICULUM_URL=

# The header's GitHub link. Change it if you fork the repository.
VITE_REPOSITORY_URL=

# Override only if the API is not reachable on the same origin as the War Room. Blank is correct
# for every Compose deployment, because nginx proxies /api/ internally.
VITE_API_BASE_URL=

# Override only if you publish LocalStack directly instead of letting nginx proxy /s3/.
VITE_LOCALSTACK_URL=
